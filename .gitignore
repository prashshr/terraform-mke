# Terraform
*.tfstate
*.tfstate.*
.crash
.terraform/
.terraform.lock.hcl
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
tfplan
tfplan.*

# Local Terraform variables and credentials
terraform.tfvars
*.tfvars
.make.env
.completion
credentials/

# Sensitive files
*.pem
*.key
*.crt
*.p12
*.jks

# Local artifacts — track scripts and manifests, ignore generated runtime files
artifacts/configs/*.yaml
artifacts/configs/*.env
artifacts/configs/mke3/
artifacts/configs/mke4/
artifacts/configs/msr4/*.env
artifacts/ssh/
artifacts/tlscerts/
artifacts/bin/
artifacts/yamls/
artifacts/msr4/values/
artifacts/mke-license/
logs/
*.log
*.bak
*.swp
*.swo
.DS_Store
*.out

# Stray files (never commit these)
:q!
nohup.out
mke-config.toml

# Editor temp files
*~
.*.swp
.vscode/
.idea/

# Python
__pycache__/
*.pyc
