apiVersion: ${apiVersion}
kind: ${kind}
metadata:
  name: mke
  namespace: ${namespace}
spec:
  airgap:
    enabled: false
  apiServer:
    externalAddress: ${api_server.external_address}
    sans:
%{ for san in api_server.sans ~}
      - ${san}
%{ endfor ~}
    audit:
      enabled: false
      level: Metadata
      logPath: /var/log/mke4/audit/audit.log
      maxAge: 30
      maxBackup: 10
      maxSize: 10
      policyFile: /etc/audit_policy.yaml
    encryptionProvider: /var/lib/k0s/encryption.cfg
    eventRateLimit:
      enabled: false
    requestTimeout: 1m0s
%{ if mke4_tls_present ~}
  certificates:
    enabled: true
    domainName: ${mke4_tls_common_name}
    ca: |
%{ for line in split("\n", mke4_tls_ca_pem) ~}
      ${line}
%{ endfor ~}
    cert: |
%{ for line in split("\n", mke4_tls_cert_pem) ~}
      ${line}
%{ endfor ~}
    key: |
%{ for line in split("\n", mke4_tls_key_pem) ~}
      ${line}
%{ endfor ~}
%{ endif ~}
  authentication:
    expiry: {}
    ldap:
      enabled: false
    oidc:
      enabled: false
    resources:
      limits:
        memory: 256Mi
      requests:
        cpu: 50m
        memory: 128Mi
    saml:
      enabled: false
  backup:
    enabled: true
    scheduled_backup:
      enabled: false
    storage_provider:
      external_options: {}
      in_cluster_options:
        admin_credentials_secret: minio-credentials
        enable_ui: true
      type: InCluster
  cloudProvider:
    enabled: false
    provider: ${cloud_provider}
  componentScheduling:
    enabled: true
    topologySpreadConstraints:
    - matchLabelKeys:
      - pod-template-hash
      maxSkew: 1
      topologyKey: kubernetes.io/hostname
      whenUnsatisfiable: ScheduleAnyway
  controllerManager:
    terminatedPodGCThreshold: 12500
  devicePlugins:
    nvidiaGPU:
      enabled: false
      mig: {}
  dns:
    lameduck: {}
  envoyGateway:
    nodeSelector:
      kubernetes.io/os: linux
    resources: {}
    tolerations:
    - effect: NoSchedule
      key: node-role.kubernetes.io/master
      operator: Exists
      value: ""
    - effect: NoSchedule
      key: node-role.kubernetes.io/control-plane
      operator: Exists
      value: ""
  etcd: {}
  gatewayMKEIngress:
    envoyProxy:
      podDisruptionBudget:
        maxUnavailable: 1
      resources: {}
    nodePorts:
      http: ${gateway_http_node_port}
      https: ${gateway_https_node_port}
    ports:
      http: 80
      https: 443
  hosts:
%{ for host in hosts ~}
  - role: ${host.role}
    ssh:
      address: ${host.ssh.address}
      keyPath: ${host.ssh.keyPath}
      port: ${host.ssh.port}
      user: ${host.ssh.user}
    privateInterface: ${host.privateInterface}
%{ endfor ~}
  ingressController:
    affinity:
      nodeAffinity: {}
    enabled: false
    extraArgs:
      enableSslPassthrough: false
    nodePorts: {}
    ports: {}
  k0rdent: {}
  k8sProviderSpecs:
    dataDir: /var/lib/k0s
  kubelet:
    eventRecordQPS: 50
    kubeletRootDir: /var/lib/kubelet
    managerKubeReserved:
      cpu: 250m
      ephemeral-storage: 4Gi
      memory: 2Gi
    maxPods: 110
    podPidsLimit: -1
    podsPerCore: 0
    protectKernelDefaults: false
    seccompDefault: false
    workerKubeReserved:
      cpu: 50m
      ephemeral-storage: 500Mi
      memory: 300Mi
  license:
    token: ""
  metallb:
    enabled: ${metallb_enabled}
  monitoring:
    enableCAdvisor: false
    grafana:
      ingress: {}
    prometheus: {}
  network:
    controlPlaneLoadBalancing:
      enabled: false
    kubeProxy:
      iptables:
        minSyncPeriod: 0s
        syncPeriod: 0s
      ipvs:
        minSyncPeriod: 0s
        syncPeriod: 0s
        tcpFinTimeout: 0s
        tcpTimeout: 0s
        udpTimeout: 0s
      metricsBindAddress: 0.0.0.0:10249
      mode: iptables
      nftables:
        minSyncPeriod: 0s
        syncPeriod: 0s
    multus:
      enabled: false
    nodePortRange: 32768-35535
    providers:
      - enabled: true
        extraConfig:
          cidrV4: ${network_cidr}
          linuxDataplane: Iptables
          loglevel: Info
        provider: calico
      - enabled: false
        provider: custom
    serviceCIDR: ${service_cidr}
  nodeLocalDNS:
    enabled: false
    nodeLocalConfigPersist: false
    resources:
      requests: {}
  operator: {}
  policyController:
    opaGatekeeper:
      enabled: false
  registries:
    chartRegistry:
      url: oci://registry.mirantis.com/mke
    imageRegistry:
      url: registry.mirantis.com/mke
  scheduler: {}
  secretsStoreCSIDriver:
    automountServiceAccountToken: true
    enabled: false
    linux:
      enabled: true
    maxCallRecvMsgSize: 4194304
    syncSecret: false
    windows:
      enabled: false
  tracking:
    enabled: true
  ui:
    resources:
      limits:
        memory: 128Mi
      requests:
        cpu: 50m
        memory: 64Mi
  version: ${version}
  windows:
    gmsa:
      enabled: false
