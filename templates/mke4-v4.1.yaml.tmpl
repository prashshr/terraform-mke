apiVersion: ${apiVersion}
kind: ${kind}
metadata:
  name: mke
  namespace: ${namespace}
spec:
  airgap:
    enabled: false
  apiServer:
    externalAddress: ${api_server.external_address}
    sans:
%{ for san in api_server.sans ~}
      - ${san}
%{ endfor ~}
    audit:
      enabled: false
      level: Metadata
      logPath: /var/log/mke4/audit/audit.log
      maxAge: 30
      maxBackup: 10
      maxSize: 10
      policyFile: /etc/audit_policy.yaml
    encryptionProvider: /var/lib/k0s/encryption.cfg
    eventRateLimit:
      enabled: false
    requestTimeout: 1m0s
%{ if mke4_tls_present ~}
  certificates:
    enabled: true
    domainName: ${mke4_tls_common_name}
    ca: |
%{ for line in split("\n", mke4_tls_ca_pem) ~}
      ${line}
%{ endfor ~}
    cert: |
%{ for line in split("\n", mke4_tls_cert_pem) ~}
      ${line}
%{ endfor ~}
    key: |
%{ for line in split("\n", mke4_tls_key_pem) ~}
      ${line}
%{ endfor ~}
%{ endif ~}
  authentication:
    expiry: {}
    ldap:
      enabled: false
    oidc:
      enabled: false
    replicaCount: 1
    saml:
      enabled: false
  cloudProvider:
    enabled: false
    provider: ${cloud_provider}
  controllerManager:
    terminatedPodGCThreshold: 12500
  devicePlugins:
    nvidiaGPU:
      enabled: false
      mig: {}
  dns:
    lameduck: {}
  etcd: {}
  hosts:
%{ for host in hosts ~}
  - role: ${host.role}
    ssh:
      address: ${host.ssh.address}
      keyPath: ${host.ssh.keyPath}
      port: ${host.ssh.port}
      user: ${host.ssh.user}
    privateInterface: ${host.privateInterface}
%{ endfor ~}
  ingressController:
    affinity:
      nodeAffinity: {}
    enabled: true
    extraArgs:
      enableSslPassthrough: false
      httpPort: 80
      httpsPort: 443
    nodePorts:
      http: ${gateway_http_node_port}
      https: ${gateway_https_node_port}
    ports: {}
    replicaCount: 2
  k8sProviderSpecs:
    dataDir: /var/lib/k0s
  kubelet:
    eventRecordQPS: 50
    kubeletRootDir: /var/lib/kubelet
    managerKubeReserved:
      cpu: 250m
      ephemeral-storage: 4Gi
      memory: 2Gi
    maxPods: 110
    podPidsLimit: -1
    podsPerCore: 0
    protectKernelDefaults: false
    seccompDefault: false
    workerKubeReserved:
      cpu: 50m
      ephemeral-storage: 500Mi
      memory: 300Mi
  license:
    token: "${mke4_license_token}"
  monitoring:
    enableCAdvisor: false
    enableGrafana: true
    grafana:
      ingress:
        enabled: false
    prometheus: {}
  network:
    cplb:
      disabled: true
    kubeProxy:
      iptables:
        minSyncPeriod: 0s
        syncPeriod: 0s
      ipvs:
        minSyncPeriod: 0s
        syncPeriod: 0s
        tcpFinTimeout: 0s
        tcpTimeout: 0s
        udpTimeout: 0s
      metricsBindAddress: 0.0.0.0:10249
      mode: iptables
      nftables:
        minSyncPeriod: 0s
        syncPeriod: 0s
    multus:
      enabled: false
    nllb:
      disabled: true
    nodePortRange: 32768-35535
    providers:
      - enabled: true
        extraConfig:
          cidrV4: ${network_cidr}
          linuxDataplane: Iptables
          loglevel: Info
        provider: calico
      - enabled: false
        provider: custom
    serviceCIDR: ${service_cidr}
  policyController:
    opaGatekeeper:
      enabled: false
  registries:
    chartRegistry:
      url: oci://registry.mirantis.com/mke
    imageRegistry:
      url: registry.mirantis.com/mke
  scheduler: {}
  tracking:
    enabled: true
  version: ${version}
