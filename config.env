# ─── config.env ────────────────────────────────────────────────────────────
# Single source of truth for terraform-ps
#
# Edit this file to tune your stack, then run:
#   make config-apply   → generate fresh terraform.tfvars
#   make create mke4    → deploy MKE4 cluster
#   make create mke3    → deploy MKE3 cluster
#   make create mke4stack → deploy MKE4 + MSR4 stack
#   make create mke3stack → deploy MKE3 + MSR2 stack
#
# Format: bash-sourceable (KEY="value" or KEY=true). Env vars override these.
# ──────────────────────────────────────────────────────────────────────────

# ── Cluster Identity ──────────────────────────────────────────────────────
# Resource prefix across cloud providers — keep it punchy and unique
CLUSTER_NAME="ps-mke"
# Primary stack type: "mke4" (k0s + mkectl engine) or "mke3" (classic Launchpad)
CLUSTER_TYPE="mke4"
# Initial admin credentials (change in production unless you enjoy living dangerously)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="mkepassword"

# ── MKE4 (Mirantis Kubernetes Engine 4.x) ──────────────────────────────────
# The next-gen Kubernetes platform powered by k0s and managed via mkectl
MKE4_VERSION="4.2.0"
# Sub-domain prefix for the Kubernetes API server (resolves to <prefix>.<ROOT_DOMAIN>)
MKE4_APP_DOMAIN="mke4test"
# Sub-domain prefix for the web UI dashboard (resolves to <prefix>.<ROOT_DOMAIN>)
MKE4_UI_DOMAIN="mke4-ui"
# Port bindings for ingress gateway and dashboard (34000/34001 is standard convention)
MKE4_UI_BACKEND_PORT=34001
MKE4_GATEWAY_HTTP_NODE_PORT=34000
MKE4_GATEWAY_HTTPS_NODE_PORT=34001
# Issue automated TLS certs for MKE4 API and UI
MKE4_TLS_ENABLED=true

# ── MKE3 (Mirantis Kubernetes Engine 3.x) ──────────────────────────────────
# The battle-tested classic MKE distribution orchestrated via Launchpad
MKE3_VERSION="3.8.11"
# Mirantis Container Runtime (MCR / Docker Engine) package version for MKE3 hosts
MKE3_MCR_VERSION="25.0.13"
# Sub-domain prefix for MKE3 cluster endpoint
MKE3_APP_DOMAIN="mke3test"
# Issue automated TLS certs for MKE3 endpoints
MKE3_TLS_ENABLED=true

# ── MSR4 (Mirantis Secure Registry 4.x for MKE4 via Helm) ─────────────────
# Modern container & artifact registry deployed as cloud-native Helm charts
MSR4_ENABLED=false
MSR4_VERSION="4.13.5"
# High Availability: 3 replicas with shared NFS storage, clustered DB & Redis
MSR4_HA=false
# Sub-domain prefix for MSR4 web interface and image pulls
MSR4_APP_DOMAIN="msr4"
# Issue automated TLS certs for MSR4 registry endpoints
MSR4_TLS_ENABLED=true
# NodePort assignments for MSR4 traffic routing
MSR4_HTTP_NODE_PORT=34002
MSR4_HTTPS_NODE_PORT=34003
MSR4_METRICS_NODE_PORT=34004

# ── MSR2 (Mirantis Secure Registry 2.x for MKE3 via Launchpad) ─────────────
# Classic containerized registry (DTR) deployed natively by Launchpad on 'msr' nodes
MSR2_ENABLED=false
MSR2_VERSION="2.9.11"
MSR2_APP_DOMAIN="msrtest"
MSR2_TLS_ENABLED=true

# ── Automation & Lifecycle ────────────────────────────────────────────────
# Auto-approve teardown without typing 'yes' (true = fast & fearless, false = ask me)
FORCE_DESTROY=true
# Maximum patience allowance in minutes for mkectl cluster deployment & addon sync
MKECTL_TIMEOUT_MINS=60
# Soft self-destruct countdown in days (0 = immortal sandbox, >0 = expiry warnings)
EXPIRY_DAYS=0

# ── Cloud Provider: AWS ───────────────────────────────────────────────────
AWS_ENABLED=true
AWS_REGION="eu-west-1"
# AWS IAM profile name (or leave empty to use standard AWS_ACCESS_KEY_ID env vars)
AWS_PROFILE="437775732836_PowerUserAccess"
AWS_CREDENTIALS_FILE="credentials/aws-profile"
# Root volume size in GB per EC2 instance (auto-expanded on first boot)
AWS_ROOT_VOLUME_SIZE=120

# Node pools layout — Format: NAME:ROLES:OS:INSTANCE_TYPE:COUNT
# Roles can be manager, worker, or msr (comma-separated if multi-role)
AWS_NODE_POOLS="aws-manager:manager:rhel96:m6id.xlarge:1 aws-worker:worker:rhel96:m6id.large:1"

# ── Cloud Provider: Hetzner ───────────────────────────────────────────────
# European cloud alternative — sleek, fast, and easy on the wallet
HETZNER_ENABLED=false
HETZNER_LOCATION="fsn1"
HETZNER_CREDENTIALS_FILE="credentials/hetzner.token"
HETZNER_CREATE_NETWORK=true
HETZNER_NETWORK_CIDR="10.42.0.0/16"
HETZNER_SUBNET_CIDR="10.42.0.0/24"
HETZNER_NETWORK_ZONE="eu-central"
# Format: NAME:ROLES:OS:SERVER_TYPE:COUNT[:PRIVATE_INTERFACE]
HETZNER_NODE_POOLS="ps-hz-manager:manager:ubuntu2204:cx23:1:enp7s0 ps-hz-worker:worker:ubuntu2204:cx23:1:enp7s0 ps-hz-msr:msr:ubuntu2204:cx23:1:enp7s0"

# ── DNS & Networking ──────────────────────────────────────────────────────
# Base apex domain under your DNS management
ROOT_DOMAIN="samkhya.cloud"
# Default ingress workload test domain
APP_DOMAIN_INGRESS="ingtest"

# ── TLS Certificates ──────────────────────────────────────────────────────
# ACME account email for automated Let's Encrypt certificate issuance
TLS_EMAIL="ops@samkhya.cloud"
# Master toggle: true = Let's Encrypt ACME with auto-renewal, false = self-signed
TLS_ACME_ENABLED=true
# TLS for general workload ingress controller
INGRESS_TLS_ENABLED=true

# ── Cloudflare DNS Management ─────────────────────────────────────────────
# Automatically publish and sync CNAME / A records to Cloudflare DNS
CLOUDFLARE_ENABLED=true
CLOUDFLARE_ZONE_NAME="samkhya.cloud"
# Cloudflare API Token (empty string falls back to $CLOUDFLARE_API_TOKEN env var)
CLOUDFLARE_API_TOKEN=""

# ── Platform Addons & Features ────────────────────────────────────────────
# Spin up a dedicated EC2 NFS server (required for MSR4 shared storage persistence)
NFS_ENABLED=true
# KOF = Kube-on-Flux telemetry, alerting & Prometheus monitoring stack (MKE4 only)
KOF_ENABLED=true
KOF_PROFILE="lean"
# k0rdent UI — multi-cluster visual management console (MKE4 only)
K0RDENT_UI_ENABLED=true
# Airgap mode: deploy bastion, isolated private subnets & local registry mirror
AIRGAP_ENABLED=false
MONITORING_ENABLED=false

# ── Advanced Overrides ────────────────────────────────────────────────────
ARTIFACTS_DIR=""
SAN_OVERRIDE=""
